{
    "lineEnds": {
        "leftCurly": "both",
        "rightCurly": "both",
        "objectLiteralCurly": {
            "leftCurly": "after"
        }
    },
    "sameLine": {
        "ifElse": "next",
        "doWhile": "next",
        "tryBody": "next",
        "tryCatch": "next"
    },
    "indentation": {
        "character": "    ",
        "trailingWhitespace": true
    },
    "wrapping": {
        "maxLineLength": 9999
    }
}